{
  "name": "qs-skills",
  "version": "3.6.3",
  "private": true,
  "description": "QuickStark's grouped engineering, productivity, and deployment skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/quickstark/skills"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version",
    "sync:outputs": "node scripts/sync-v3-docs.mjs && node scripts/sync-skill-output-contracts.mjs",
    "check:outputs": "node scripts/sync-v3-docs.mjs --check && node scripts/sync-skill-output-contracts.mjs --check",
    "sync:codex": "node scripts/sync-v3-docs.mjs && node scripts/sync-skill-output-contracts.mjs && node scripts/sync-codex-plugin.mjs",
    "check:codex": "node scripts/sync-v3-docs.mjs --check && node scripts/sync-skill-output-contracts.mjs --check && node scripts/sync-codex-plugin.mjs --check",
    "test": "node scripts/qs-test-runner.mjs",
    "test:preflight": "node scripts/qs-test-preflight.mjs",
    "skills:plan": "node scripts/managed-skills.mjs plan",
    "skills:update": "node scripts/managed-skills.mjs update",
    "skills:sync": "node scripts/managed-skills.mjs sync",
    "skills:verify": "npm run check:codex && npm test && node scripts/managed-skills.mjs verify --json",
    "personal-skills:inventory": "node scripts/sync-personal-skills.mjs inventory",
    "personal-skills:adopt": "node scripts/sync-personal-skills.mjs adopt",
    "personal-skills:plan": "node scripts/sync-personal-skills.mjs plan",
    "personal-skills:sync": "node scripts/sync-personal-skills.mjs sync",
    "personal-skills:verify": "node scripts/sync-personal-skills.mjs verify"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
