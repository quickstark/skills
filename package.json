{
  "name": "qs-skills",
  "version": "2.1.0",
  "private": true,
  "description": "QuickStark's grouped engineering, productivity, and deployment skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/quickstark/skills"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version",
    "sync:outputs": "node scripts/sync-skill-output-contracts.mjs",
    "check:outputs": "node scripts/sync-skill-output-contracts.mjs --check",
    "sync:codex": "node scripts/sync-skill-output-contracts.mjs && node scripts/sync-codex-plugin.mjs",
    "check:codex": "node scripts/sync-skill-output-contracts.mjs --check && node scripts/sync-codex-plugin.mjs --check",
    "test": "node --test tests/qs-skills.test.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
